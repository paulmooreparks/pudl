{
  "$comment": "PUDL's components, for tools: each one's markup, the grammar of its parts, its variants and its states. docs/COMPONENTS.md describes this file; docs/CONTRACT.md is the contract it formalises, and tests/components.test.js keeps the two and the stylesheet in step.",
  "grammar": {
    "raised": "Can be pressed: lit along its top, shading to its foot, bounded by a hairline, casting a small shadow.",
    "sunken": "Takes input: below its surroundings, with a shadow inside its top edge.",
    "flat": "There to be read.",
    "list": "A list of places or choices: flat rows that respond under the pointer and mark the current one.",
    "handle": "Dragged, such as the divider between two panes; flat, with the grip glyph.",
    "link": "Goes somewhere; underlined in running text.",
    "tab": "Raised, except the current tab, which stands flat and open into the content below it.",
    "layout": "Arranges other components and has no surface of its own."
  },
  "components": [
    {
      "id": "selection-actions", "name": "Selection actions", "kind": "layout",
      "spec": "08-components/annotations.md", "requires": ["pudl-annotations.js"],
      "template": "<article data-selection-actions=\"selection-offer\">Select this text</article><div class=\"selection-actions\" id=\"selection-offer\"><button class=\"btn btn-sm\" type=\"button\" data-selection-action=\"quote\">Quote</button></div>",
      "parts": [{ "selector": ".selection-actions .btn", "surface": "raised" }]
    },
    {
      "id": "margin-notes", "name": "Margin notes", "kind": "flat",
      "spec": "08-components/annotations.md", "requires": ["pudl-annotations.js"],
      "template": "<div class=\"noted\"><article class=\"noted-body\"><p id=\"sample-passage\">Passage</p></article><aside class=\"margin-note\" data-note-for=\"sample-passage\">Note</aside></div>",
      "parts": [{ "selector": ".margin-note", "surface": "flat" }]
    },
    {
      "id": "button",
      "name": "Button",
      "kind": "raised",
      "spec": "08-components/buttons.md",
      "template": "<button type=\"button\" class=\"btn\">Button</button>",
      "parts": [{ "selector": ".btn", "surface": "raised" }],
      "variants": [
        { "name": "Primary", "class": "btn-primary", "group": "kind" },
        { "name": "Danger", "class": "btn-danger", "group": "kind" },
        { "name": "Disclosure", "class": "disclosure", "group": "kind" },
        { "name": "Small", "class": "btn-sm" }
      ],
      "states": [
        { "name": "Disabled", "attribute": "disabled" },
        { "name": "Latched", "attribute": "aria-pressed", "value": "true" },
        { "name": "Expanded, for a disclosure", "attribute": "aria-expanded", "value": "true", "off": "false" }
      ]
    },
    {
      "id": "icon-button",
      "name": "Icon button",
      "kind": "raised",
      "spec": "08-components/glyph-buttons.md",
      "template": "<button type=\"button\" class=\"icon-btn\" aria-label=\"Settings\"><span class=\"glyph\" style=\"--glyph: var(--glyph-gear)\" aria-hidden=\"true\"></span></button>",
      "parts": [{ "selector": ".icon-btn", "surface": "raised" }],
      "variants": [{ "name": "Danger", "class": "danger" }],
      "states": [{ "name": "Disabled", "attribute": "disabled" }],
      "properties": [{ "name": "Label", "attribute": "aria-label", "required": true }]
    },
    {
      "id": "link-button",
      "name": "Link-styled button",
      "kind": "link",
      "spec": "08-components/buttons.md",
      "template": "<button type=\"button\" class=\"link\">Show more</button>",
      "parts": [{ "selector": ".link", "surface": "link" }],
      "variants": [{ "name": "Muted", "class": "link-muted", "replaces": "link" }]
    },
    {
      "id": "text-field",
      "name": "Text field",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"field\">Label</label><input class=\"form-input\" id=\"field\" name=\"field\"><p class=\"form-help\">Help for the field.</p></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".form-input", "surface": "sunken" },
        { "selector": ".form-help", "surface": "flat" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": ".form-input" },
        { "name": "Invalid", "attribute": "aria-invalid", "value": "true", "on": ".form-input" },
        { "name": "Read-only", "attribute": "readonly", "on": ".form-input" },
        { "name": "Disabled", "attribute": "disabled", "on": ".form-input" }
      ],
      "properties": [
        { "name": "Type", "attribute": "type", "on": ".form-input", "values": ["text", "email", "number", "date", "search", "url", "tel", "password"] },
        { "name": "Name", "attribute": "name", "on": ".form-input" }
      ]
    },
    {
      "id": "select",
      "name": "Select",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"choice\">Label</label><span class=\"form-select-wrap\"><select class=\"form-select\" id=\"choice\" name=\"choice\"><option>First</option><option>Second</option></select></span></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".form-select", "surface": "sunken" },
        { "selector": ".form-select-wrap", "pseudo": "::after", "surface": "flat" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": ".form-select" },
        { "name": "Invalid", "attribute": "aria-invalid", "value": "true", "on": ".form-select" },
        { "name": "Disabled", "attribute": "disabled", "on": ".form-select" }
      ]
    },
    {
      "id": "combo-box",
      "name": "Combo box",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-combo.js"],
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"currency\">Label</label><span class=\"combo\"><input class=\"form-input\" id=\"currency\" name=\"currency\" list=\"currency-options\" autocomplete=\"off\"><datalist id=\"currency-options\"><option value=\"PHP\">Philippine peso</option><option value=\"SGD\">Singapore dollar</option></datalist></span></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".combo > .form-input", "surface": "sunken" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": ".form-input" },
        { "name": "Invalid", "attribute": "aria-invalid", "value": "true", "on": ".form-input" },
        { "name": "Read-only", "attribute": "readonly", "on": ".form-input" },
        { "name": "Disabled", "attribute": "disabled", "on": ".form-input" }
      ],
      "properties": [
        { "name": "Options from the server", "attribute": "data-combo-src", "on": ".combo" },
        { "name": "Completes a match", "attribute": "data-combo-complete", "on": ".form-input", "boolean": true },
        { "name": "An option's keys", "attribute": "data-combo-keys", "on": "option" }
      ]
    },
    {
      "id": "searchable-select",
      "name": "Searchable select",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-combo.js"],
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"country\">Label</label><span class=\"form-select-wrap\"><select class=\"form-select\" id=\"country\" name=\"country\" data-combo><option value=\"PH\">Philippines</option><option value=\"SG\">Singapore</option></select></span></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".form-select", "surface": "sunken" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": ".form-select" },
        { "name": "Disabled", "attribute": "disabled", "on": ".form-select" }
      ],
      "properties": [
        { "name": "Options from the server", "attribute": "data-combo-src", "on": ".form-select" }
      ]
    },
    {
      "id": "progress-bar",
      "name": "Progress bar",
      "kind": "flat",
      "spec": "08-components/progress-and-meters.md",
      "template": "<div class=\"progress-row\"><span class=\"progress-label\" id=\"p-name\">Uploading</span><progress class=\"progress\" value=\"42\" max=\"100\" aria-labelledby=\"p-name\"></progress><span class=\"progress-value\">42%</span></div>",
      "parts": [
        { "selector": ".progress", "surface": "flat" },
        { "selector": ".progress-value", "surface": "flat" }
      ]
    },
    {
      "id": "meter",
      "name": "Meter",
      "kind": "flat",
      "spec": "08-components/progress-and-meters.md",
      "requires": ["pudl-fields.js"],
      "template": "<div class=\"meter-row\"><span class=\"meter-label\" id=\"m-name\">Storage</span><meter class=\"meter\" min=\"0\" max=\"100\" low=\"75\" high=\"90\" optimum=\"0\" value=\"31\" aria-labelledby=\"m-name\"></meter><span class=\"meter-value\">31%</span></div>",
      "parts": [
        { "selector": ".meter", "surface": "flat" },
        { "selector": ".meter-value", "surface": "flat" }
      ],
      "variants": [{ "name": "With marks", "class": "marks", "on": ".meter" }]
    },
    {
      "id": "slider",
      "name": "Slider",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-fields.js"],
      "template": "<div class=\"range-row\"><input class=\"form-range\" type=\"range\" id=\"r\" min=\"0\" max=\"100\" value=\"40\" aria-label=\"Width\"><output for=\"r\">40</output></div>",
      "parts": [
        { "selector": ".range-row > output", "surface": "flat" }
      ],
      "states": [{ "name": "Disabled", "attribute": "disabled", "on": "input" }]
    },
    {
      "id": "number-field",
      "name": "Number field",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-fields.js"],
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"n\">Label</label><span class=\"number-field\"><input class=\"form-input\" type=\"number\" id=\"n\" name=\"n\" min=\"0\" max=\"20\" value=\"3\"></span></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".number-field > .form-input", "surface": "sunken" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": "input" },
        { "name": "Disabled", "attribute": "disabled", "on": "input" }
      ]
    },
    {
      "id": "password-field",
      "name": "Password field",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-fields.js"],
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"pw\">Label</label><span class=\"password-field\"><input class=\"form-input\" type=\"password\" id=\"pw\" name=\"pw\"></span></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".password-field > .form-input", "surface": "sunken" }
      ],
      "properties": [{ "name": "Glyph key", "attribute": "data-password-toggle", "value": "glyph", "on": "input" }]
    },
    {
      "id": "figure",
      "name": "Figure",
      "kind": "flat",
      "spec": "08-components/images-and-avatars.md",
      "requires": ["pudl-fields.js"],
      "template": "<figure class=\"figure\"><img src=\"data:image/gif;base64,R0lGODlhAQABAAAAACw=\" alt=\"A receipt\" width=\"160\" height=\"90\"><figcaption>Caption.</figcaption></figure>",
      "parts": [
        { "selector": ".figure > figcaption", "surface": "flat" }
      ],
      "variants": [
        { "name": "Caption over the picture", "class": "caption-over" },
        { "name": "Unframed", "class": "plain" },
        { "name": "Fitted inside", "class": "contain" }
      ]
    },
    {
      "id": "avatar",
      "name": "Avatar",
      "kind": "flat",
      "spec": "08-components/images-and-avatars.md",
      "template": "<span class=\"avatar-wrap\"><span class=\"avatar\" role=\"img\" aria-label=\"Ana Reyes\">AR</span><span class=\"avatar-status\" data-status=\"online\" aria-label=\"Online\"></span></span>",
      "parts": [
        { "selector": ".avatar", "surface": "flat" }
      ],
      "variants": [
        { "name": "Small", "class": "sm" },
        { "name": "Large", "class": "lg" },
        { "name": "Extra large", "class": "xl" },
        { "name": "Tinted by name", "class": "tint" }
      ]
    },
    {
      "id": "list-box",
      "name": "List box",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-listbox.js"],
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"accounts\">Label</label><select class=\"form-select\" id=\"accounts\" name=\"accounts\" multiple size=\"4\" data-listbox><option selected>Billable</option><option>Non-billable</option><option>Internal</option></select></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": "select" },
        { "name": "Disabled", "attribute": "disabled", "on": "select" }
      ],
      "properties": [
        { "name": "Several may be chosen", "attribute": "multiple", "on": "select", "boolean": true },
        { "name": "Rows tall", "attribute": "size", "on": "select" }
      ]
    },
    {
      "id": "token-field",
      "name": "Token field",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-combo.js"],
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"tags\">Label</label><span class=\"combo\" data-combo-tokens><input class=\"form-input\" id=\"tags\" name=\"tags\" value=\"receipts, q4\"></span></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".combo > .form-input", "surface": "sunken" }
      ],
      "properties": [
        { "name": "Separator", "attribute": "data-combo-separator", "on": ".combo" },
        { "name": "Most values", "attribute": "data-combo-max", "on": ".combo" }
      ]
    },
    {
      "id": "date-field",
      "name": "Date field",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-date.js"],
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"due\">Label</label><input class=\"form-input\" type=\"date\" id=\"due\" name=\"due\" value=\"2026-10-22\" data-date></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": "input[type=date]", "surface": "sunken" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": "input" },
        { "name": "Disabled", "attribute": "disabled", "on": "input" }
      ],
      "properties": [
        { "name": "Style", "attribute": "data-date-style", "on": "input", "values": ["iso", "short", "medium", "long"] },
        { "name": "Earliest", "attribute": "min", "on": "input" },
        { "name": "Latest", "attribute": "max", "on": "input" }
      ]
    },
    {
      "id": "time-field",
      "name": "Time field",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "requires": ["pudl-date.js"],
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"at\">Label</label><input class=\"form-input\" type=\"time\" id=\"at\" name=\"at\" value=\"13:30\" step=\"900\" data-date></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": "input[type=time]", "surface": "sunken" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": "input" },
        { "name": "Disabled", "attribute": "disabled", "on": "input" }
      ],
      "properties": [
        { "name": "List interval in minutes", "attribute": "data-time-list", "on": "input" },
        { "name": "Step in seconds", "attribute": "step", "on": "input" }
      ]
    },
    {
      "id": "text-area",
      "name": "Text area",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"notes\">Label</label><textarea class=\"form-textarea\" id=\"notes\" name=\"notes\"></textarea></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".form-textarea", "surface": "sunken" }
      ],
      "states": [
        { "name": "Required", "attribute": "required", "on": ".form-textarea" },
        { "name": "Invalid", "attribute": "aria-invalid", "value": "true", "on": ".form-textarea" },
        { "name": "Read-only", "attribute": "readonly", "on": ".form-textarea" },
        { "name": "Disabled", "attribute": "disabled", "on": ".form-textarea" }
      ]
    },
    {
      "id": "options",
      "name": "Check boxes and radio buttons",
      "kind": "sunken",
      "spec": "08-components/fields.md",
      "template": "<fieldset class=\"form-fieldset\"><legend>Legend</legend><div class=\"form-options\"><label class=\"check\"><input type=\"radio\" name=\"option\" checked> First</label><label class=\"check\"><input type=\"radio\" name=\"option\"> Second</label></div></fieldset>",
      "parts": [
        { "selector": ".form-fieldset", "surface": "layout" },
        { "selector": "label.check", "surface": "flat" }
      ],
      "variants": [{ "name": "In a row", "class": "inline", "on": ".form-options" }],
      "states": [{ "name": "Disabled", "attribute": "disabled", "on": ".form-fieldset" }]
    },
    {
      "id": "file-field",
      "name": "File field",
      "kind": "raised",
      "spec": "08-components/fields.md",
      "template": "<div class=\"form-group\"><label class=\"form-label\" for=\"upload\">Label</label><input class=\"form-file\" type=\"file\" id=\"upload\" name=\"upload\"></div>",
      "parts": [
        { "selector": ".form-label", "surface": "flat" },
        { "selector": ".form-file", "surface": "flat" },
        { "selector": ".form-file", "pseudo": "::file-selector-button", "surface": "raised" }
      ],
      "states": [{ "name": "Disabled", "attribute": "disabled", "on": ".form-file" }]
    },
    {
      "id": "switch",
      "name": "Switch",
      "kind": "sunken",
      "spec": "08-components/switches.md",
      "template": "<button type=\"button\" class=\"switch\" role=\"switch\" aria-checked=\"false\"><span class=\"switch-track\"><span class=\"switch-thumb\"></span></span> Label</button>",
      "parts": [
        { "selector": ".switch-track", "surface": "sunken" },
        { "selector": ".switch-thumb", "surface": "raised" }
      ],
      "states": [
        { "name": "On", "attribute": "aria-checked", "value": "true", "off": "false" },
        { "name": "Disabled", "attribute": "disabled" }
      ]
    },
    {
      "id": "segmented",
      "name": "Segmented control",
      "kind": "raised",
      "spec": "08-components/segmented-controls.md",
      "requires": ["pudl-menu.js"],
      "template": "<div class=\"seg\" role=\"group\" aria-label=\"View\"><button type=\"button\" aria-pressed=\"true\">First</button><button type=\"button\" aria-pressed=\"false\">Second</button></div>",
      "parts": [
        { "selector": ".seg > [aria-pressed=\"false\"]", "surface": "raised" }
      ],
      "states": [
        { "name": "Chosen, pressed in", "attribute": "aria-pressed", "value": "true", "on": ".seg > button" }
      ],
      "variants": [
        { "name": "Pill", "class": "pill" },
        { "name": "Small", "class": "sm" }
      ],
      "properties": [{ "name": "Collapses on a phone", "attribute": "data-seg-menu", "boolean": true }]
    },
    {
      "id": "badge",
      "name": "Badge",
      "kind": "flat",
      "spec": "08-components/badges-and-chips.md",
      "template": "<span class=\"badge\">Draft</span>",
      "parts": [{ "selector": ".badge", "surface": "flat" }],
      "variants": [
        { "name": "Needs attention", "class": "warn", "group": "status" },
        { "name": "Failed", "class": "danger", "group": "status" },
        { "name": "Done", "class": "positive", "group": "status" },
        { "name": "Accent", "class": "accent", "group": "status" }
      ]
    },
    {
      "id": "chip",
      "name": "Chip",
      "kind": "flat",
      "spec": "08-components/badges-and-chips.md",
      "template": "<span class=\"chip\">travel</span>",
      "parts": [{ "selector": ".chip", "surface": "flat" }]
    },
    {
      "id": "filter-chip",
      "name": "Filter chip",
      "kind": "flat",
      "spec": "08-components/badges-and-chips.md",
      "template": "<span class=\"filter-chip\"><span class=\"filter-chip-kind\">trip</span> manila <a class=\"filter-chip-x\" href=\"?\" aria-label=\"Remove the trip filter\"></a></span>",
      "parts": [{ "selector": ".filter-chip", "surface": "flat" }]
    },
    {
      "id": "status-area",
      "name": "Status area",
      "kind": "raised",
      "spec": "08-components/application-bar.md",
      "context": "topbar-chrome",
      "template": "<nav class=\"status-area\" aria-label=\"Status\"><a class=\"status-item\" href=\"?queue\" aria-label=\"Queue: 3 waiting\" title=\"Queue: 3 waiting\"><span class=\"glyph\" style=\"--glyph: var(--glyph-comments)\" aria-hidden=\"true\"></span><span class=\"badge warn\" aria-hidden=\"true\">3</span></a></nav>",
      "parts": [
        { "selector": ".status-area", "surface": "raised" },
        { "selector": ".status-item", "surface": "flat" }
      ],
      "properties": [{ "name": "Label", "attribute": "aria-label", "on": ".status-item", "required": true }],
      "slots": [{ "selector": ".status-area", "name": "Items" }]
    },
    {
      "id": "card",
      "name": "Card",
      "kind": "flat",
      "spec": "08-components/cards.md",
      "template": "<div class=\"card\"><h3 class=\"card-title\">Title</h3><p class=\"card-subtitle\">Subtitle</p><p class=\"card-desc\">What the card is about.</p></div>",
      "parts": [{ "selector": ".card", "surface": "flat" }],
      "slots": [{ "selector": ".card", "name": "Content" }]
    },
    {
      "id": "disclosure-card",
      "name": "Disclosure card",
      "kind": "flat",
      "spec": "08-components/cards.md",
      "requires": ["pudl-disclose.js"],
      "template": "<section class=\"card disclosure\"><div class=\"card-head\"><button type=\"button\" class=\"card-toggle\" aria-expanded=\"false\"></button><h3 class=\"card-title\">Title</h3><span class=\"card-summary\">A line shown while closed.</span></div><div class=\"card-body\"><p>What the card holds.</p></div><div class=\"card-actions\"><button type=\"button\" class=\"btn btn-sm\">Action</button></div></section>",
      "parts": [
        { "selector": ".card", "surface": "flat" },
        { "selector": ".card-toggle", "surface": "raised" }
      ],
      "slots": [{ "selector": ".card-body", "name": "Body" }, { "selector": ".card-actions", "name": "Actions" }]
    },
    {
      "id": "row-editor",
      "name": "Row editor",
      "kind": "sunken",
      "spec": "08-components/row-editor.md",
      "requires": ["pudl-rows.js"],
      "template": "<div class=\"row-editor-wrap\"><table class=\"row-editor\" aria-label=\"Items\"><thead><tr><th scope=\"col\">Name</th><th scope=\"col\" class=\"row-editor-remove\"><span class=\"visually-hidden\">Remove</span></th></tr></thead><tbody><tr><td data-label=\"Name\"><input class=\"form-input\" aria-label=\"Name of item 1\"></td><td class=\"row-editor-remove\"><button type=\"button\" class=\"icon-btn danger\" data-row-remove aria-label=\"Remove item 1\"><span class=\"glyph\" style=\"--glyph: var(--glyph-close)\" aria-hidden=\"true\"></span></button></td></tr></tbody></table><button type=\"button\" class=\"btn row-editor-add\" data-row-add><span class=\"glyph\" style=\"--glyph: var(--glyph-plus)\" aria-hidden=\"true\"></span> Add an Item</button></div>",
      "parts": [
        { "selector": ".row-editor td > .form-input", "surface": "sunken" },
        { "selector": "[data-row-remove]", "surface": "raised" },
        { "selector": ".row-editor-add", "surface": "raised" }
      ]
    },
    {
      "id": "toolbar",
      "name": "Toolbar",
      "kind": "raised",
      "spec": "08-components/toolbar.md",
      "requires": ["pudl-toolbar.js"],
      "template": "<div class=\"toolbar\" role=\"toolbar\" aria-label=\"Formatting\"><div class=\"toolbar-group\" role=\"group\" aria-label=\"Text\"><button type=\"button\" class=\"icon-btn\" aria-label=\"Bold\" aria-pressed=\"false\"><span class=\"glyph\" style=\"--glyph: var(--glyph-bold)\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"icon-btn\" aria-label=\"Italic\" aria-pressed=\"false\"><span class=\"glyph\" style=\"--glyph: var(--glyph-italic)\" aria-hidden=\"true\"></span></button></div><div class=\"toolbar-group\" role=\"group\" aria-label=\"Lists\"><button type=\"button\" class=\"icon-btn\" aria-label=\"Bulleted list\"><span class=\"glyph\" style=\"--glyph: var(--glyph-list)\" aria-hidden=\"true\"></span></button></div></div>",
      "parts": [{ "selector": ".toolbar .icon-btn", "surface": "raised" }],
      "properties": [
        { "name": "Folds to one row", "attribute": "data-toolbar-fold" },
        { "name": "Captions", "attribute": "data-toolbar-captions", "values": ["start", "none"] },
        { "name": "Label", "attribute": "aria-label", "required": true }
      ],
      "slots": [{ "selector": ".toolbar", "name": "Groups" }]
    },
    {
      "id": "ribbon",
      "name": "Ribbon",
      "kind": "tab",
      "spec": "08-components/ribbons.md",
      "requires": ["pudl-menu.js", "pudl-toolbar.js"],
      "template": "<div class=\"ribbon\" id=\"ribbon-sample\" aria-label=\"Editor\"><div class=\"tablist\" role=\"tablist\" aria-label=\"Editor\"><button role=\"tab\" aria-controls=\"ribbon-sample-home\" aria-selected=\"true\">Home</button><button role=\"tab\" aria-controls=\"ribbon-sample-insert\">Insert</button></div><div class=\"toolbar\" id=\"ribbon-sample-home\" aria-label=\"Home\" data-toolbar-fold><div class=\"toolbar-group\" data-toolbar-group=\"Text\" data-toolbar-glyph=\"bold\"><button type=\"button\" class=\"btn btn-sm\" aria-pressed=\"false\" data-toolbar-glyph-only><span class=\"glyph\" style=\"--glyph: var(--glyph-bold)\" aria-hidden=\"true\"></span><span class=\"toolbar-words\">Bold</span></button></div></div><div class=\"toolbar\" id=\"ribbon-sample-insert\" aria-label=\"Insert\" data-toolbar-fold><div class=\"toolbar-group\" data-toolbar-group=\"Blocks\" data-toolbar-glyph=\"table\"><button type=\"button\" class=\"btn btn-sm\"><span class=\"glyph\" style=\"--glyph: var(--glyph-table)\" aria-hidden=\"true\"></span><span class=\"toolbar-words\">Table</span></button></div></div></div>",
      "parts": [
        { "selector": ".ribbon [role=\"tab\"]:not([aria-selected=\"true\"])", "surface": "tab" },
        { "selector": ".ribbon .toolbar .btn", "surface": "raised" }
      ],
      "states": [{ "name": "Folded into menus", "attribute": "data-ribbon-folded" }],
      "properties": [{ "name": "Toggle words", "attribute": "data-ribbon-toggle-text" }],
      "slots": [{ "selector": ".ribbon > .toolbar", "name": "Groups" }]
    },
    {
      "id": "zoom",
      "name": "Zoom",
      "kind": "raised",
      "spec": "08-components/zoom.md",
      "requires": ["pudl-zoom.js"],
      "template": "<div class=\"zoom\" role=\"group\" aria-label=\"Zoom\"><button type=\"button\" class=\"icon-btn\" data-zoom=\"out\" aria-label=\"Zoom Out\"><span class=\"glyph\" style=\"--glyph: var(--glyph-minus)\" aria-hidden=\"true\"></span></button><output class=\"zoom-scale\" aria-live=\"polite\">100%</output><button type=\"button\" class=\"icon-btn\" data-zoom=\"in\" aria-label=\"Zoom In\"><span class=\"glyph\" style=\"--glyph: var(--glyph-plus)\" aria-hidden=\"true\"></span></button><button type=\"button\" class=\"btn btn-sm\" data-zoom=\"fit\">Fit</button></div><div class=\"zoom-viewport\" aria-label=\"Picture\" style=\"height: 240px\"><svg viewBox=\"0 0 800 400\" width=\"800\" height=\"400\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"20\" y=\"20\" width=\"760\" height=\"360\" rx=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg></div>",
      "parts": [
        { "selector": ".zoom .icon-btn", "surface": "raised" },
        { "selector": ".zoom-scale", "surface": "flat" },
        { "selector": ".zoom-viewport", "surface": "sunken" }
      ],
      "slots": [{ "selector": ".zoom-viewport", "name": "Picture" }]
    },
    {
      "id": "row-list",
      "name": "Row list",
      "kind": "list",
      "spec": "08-components/master-detail.md",
      "requires": ["pudl-md.js"],
      "template": "<ul class=\"row-list\" aria-label=\"Items\"><li class=\"md-row\"><a class=\"md-item\" href=\"?item=1\" aria-current=\"true\">First<span class=\"md-meta\">Yesterday</span></a></li><li class=\"md-row\"><a class=\"md-item\" href=\"?item=2\">Second<span class=\"md-meta\">Today</span></a></li></ul>",
      "parts": [{ "selector": ".row-list .md-item", "surface": "list" }]
    },
    {
      "id": "stack",
      "name": "Stack",
      "kind": "layout",
      "spec": "08-components/layout.md",
      "template": "<div class=\"vstack\"><p>First</p><p>Second</p></div>",
      "parts": [{ "selector": ".vstack", "surface": "layout" }],
      "variants": [
        { "name": "No gap", "class": "gap-0", "group": "gap" }, { "name": "Gap 1", "class": "gap-1", "group": "gap" },
        { "name": "Gap 2", "class": "gap-2", "group": "gap" }, { "name": "Gap 4", "class": "gap-4", "group": "gap" },
        { "name": "Gap 5", "class": "gap-5", "group": "gap" }, { "name": "Gap 6", "class": "gap-6", "group": "gap" }
      ],
      "slots": [{ "selector": ".vstack", "name": "Components" }]
    },
    {
      "id": "row",
      "name": "Row",
      "kind": "layout",
      "spec": "08-components/layout.md",
      "template": "<div class=\"hstack\"><span>First</span><span>Second</span></div>",
      "parts": [{ "selector": ".hstack", "surface": "layout" }],
      "variants": [
        { "name": "Centred", "class": "align-center", "group": "align" }, { "name": "To the end", "class": "align-end", "group": "align" },
        { "name": "On the first line of text", "class": "align-baseline", "group": "align" },
        { "name": "No gap", "class": "gap-0", "group": "gap" }, { "name": "Gap 1", "class": "gap-1", "group": "gap" },
        { "name": "Gap 2", "class": "gap-2", "group": "gap" }, { "name": "Gap 4", "class": "gap-4", "group": "gap" },
        { "name": "Gap 5", "class": "gap-5", "group": "gap" }, { "name": "Gap 6", "class": "gap-6", "group": "gap" }
      ],
      "slots": [{ "selector": ".hstack", "name": "Components" }]
    },
    {
      "id": "column-grid",
      "name": "Grid of columns",
      "kind": "layout",
      "spec": "08-components/layout.md",
      "template": "<div class=\"auto-grid\"><div>First</div><div>Second</div><div>Third</div></div>",
      "parts": [{ "selector": ".auto-grid", "surface": "layout" }],
      "variants": [
        { "name": "No gap", "class": "gap-0", "group": "gap" }, { "name": "Gap 1", "class": "gap-1", "group": "gap" },
        { "name": "Gap 2", "class": "gap-2", "group": "gap" }, { "name": "Gap 4", "class": "gap-4", "group": "gap" },
        { "name": "Gap 5", "class": "gap-5", "group": "gap" }, { "name": "Gap 6", "class": "gap-6", "group": "gap" }
      ],
      "properties": [{ "name": "Least column width", "attribute": "style", "values": ["--grid-min: 160px", "--grid-min: 224px", "--grid-min: 320px"] }],
      "slots": [{ "selector": ".auto-grid", "name": "Components" }]
    },
    {
      "id": "settings-panel",
      "name": "Settings panel",
      "kind": "layout",
      "spec": "08-components/cards.md",
      "template": "<div class=\"settings-panel\"><section class=\"card\"><h2 class=\"card-title\">Group</h2><p class=\"card-desc\">What these settings change.</p><label class=\"check\"><input type=\"checkbox\"> A setting</label><div class=\"settings-actions\"><button class=\"btn btn-primary\" type=\"submit\">Save</button></div><p class=\"settings-status\" role=\"status\"></p></section></div>",
      "parts": [
        { "selector": ".settings-panel", "surface": "layout" },
        { "selector": ".settings-panel > .card", "surface": "flat" }
