      "requires": ["pudl-toast.js"],
      "template": "<div class=\"notice\" role=\"status\"><div class=\"notice-content\"><p class=\"notice-title\">Title</p><p class=\"notice-body\">What the reader should know.</p></div><button class=\"notice-close\" type=\"button\" aria-label=\"Dismiss\"></button></div>",
