      "slots": [{ "selector": ".settings-panel", "name": "Cards" }]
    },
    {
      "id": "key-value-table",
      "name": "Key/value table",
      "kind": "flat",
      "spec": "08-components/key-value-tables.md",
      "template": "<table class=\"kv-table\"><tr><th>Key</th><td>Value</td></tr><tr><th>Another</th><td>Value</td></tr></table>",
      "parts": [{ "selector": ".kv-table", "surface": "flat" }]
    },
    {
      "id": "data-table",
      "name": "Data table",
      "kind": "flat",
      "spec": "08-components/data-tables.md",
      "template": "<div class=\"data-table-wrap\"><table class=\"data-table\"><thead><tr><th scope=\"col\">Name</th><th scope=\"col\" class=\"num\">Amount</th></tr></thead><tbody><tr><td data-label=\"Name\">Hotel</td><td class=\"num\" data-label=\"Amount\">21,600</td></tr></tbody></table></div>",
      "parts": [{ "selector": ".data-table", "surface": "flat" }],
