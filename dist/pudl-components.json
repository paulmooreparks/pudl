      "template": "<span class=\"split-btn\"><button class=\"btn\" type=\"button\">Save</button><span class=\"menu\"><button class=\"btn menu-btn\" type=\"button\" popovertarget=\"split-more\" aria-label=\"More ways to save\"></button><nav class=\"menu-panel\" id=\"split-more\" popover aria-label=\"More ways to save\"><button class=\"menu-action\" type=\"button\">Save as…</button></nav></span></span>",
