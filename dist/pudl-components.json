      "variants": [{ "name": "Primary", "class": "btn-primary", "on": ".btn" }]
    },
    {
      "id": "popover",
      "name": "Popover",
      "kind": "flat",
      "spec": "08-components/popovers.md",
      "requires": ["pudl-menu.js"],
      "template": "<div class=\"popover\" id=\"popover\" popover role=\"dialog\" aria-labelledby=\"popover-title\"><div class=\"popover-head\"><h2 class=\"popover-title\" id=\"popover-title\">Title</h2><button class=\"icon-btn popover-close\" type=\"button\" popovertarget=\"popover\" popovertargetaction=\"hide\" aria-label=\"Close\"></button></div><p>Content.</p><div class=\"popover-actions\"><button class=\"btn btn-sm\" type=\"button\">Done</button></div></div>",
      "opener": "<button class=\"btn\" type=\"button\" popovertarget=\"popover\">Open</button>",
