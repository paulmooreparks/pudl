      "parts": [
        { "selector": "[role=\"tab\"][aria-selected=\"true\"]", "surface": "tab" },
        { "selector": "[role=\"tab\"][aria-selected=\"false\"]", "surface": "raised" }
      ]
    },
    {
      "id": "split-button",
