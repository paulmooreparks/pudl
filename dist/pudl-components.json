      "spec": "08-components/master-detail.md",
      "requires": ["pudl-md.js"],
      "template": "<div class=\"md-layout\" style=\"height: 320px\"><div class=\"md-body\"><nav class=\"md-sidebar\" aria-label=\"Items\"><div class=\"md-row\"><a class=\"md-item\" href=\"?item=1\" aria-current=\"true\">First</a></div><div class=\"md-row\"><a class=\"md-item\" href=\"?item=2\">Second</a></div></nav><div class=\"md-resize\" aria-label=\"Resize the list\"></div><section class=\"md-detail\" tabindex=\"0\">Detail</section></div></div>",
