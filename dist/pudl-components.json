      "parts": [{ "selector": ".loading", "surface": "flat" }]
    },
    {
      "id": "pagination",
      "name": "Pagination",
      "kind": "raised",
      "spec": "08-components/pagination.md",
      "template": "<nav class=\"pagination\" aria-label=\"Pages\"><span class=\"pagination-summary\">Showing 1 to 20 of 45</span><a class=\"page-link\" href=\"?page=1\" aria-current=\"page\">1</a><a class=\"page-link\" href=\"?page=2\">2</a><a class=\"page-link\" href=\"?page=2\" rel=\"next\">Next</a></nav>",
      "parts": [
        { "selector": ".pagination-summary", "surface": "flat" },
        { "selector": ".page-link:not([aria-current])", "surface": "raised" }
      ]
