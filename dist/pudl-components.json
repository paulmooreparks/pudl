        { "selector": ".popover-title", "surface": "flat" },
        { "selector": ".popover-close", "surface": "raised" }
      ],
      "variants": [{ "name": "Pointer", "class": "pointer" }]
    },
    {
      "id": "stepper",
      "name": "Stepper",
      "kind": "flat",
      "spec": "08-components/steppers.md",
      "template": "<ol class=\"stepper\" aria-label=\"Task\"><li class=\"done\"><a href=\"#one\">One<span class=\"visually-hidden\"> (done)</span></a></li><li aria-current=\"step\"><span>Two</span></li><li><span>Three</span></li></ol>",
      "parts": [
        { "selector": ".stepper > li", "surface": "flat" }
      ],
      "variants": [{ "name": "Down the side", "class": "vertical" }],
      "states": [
        { "name": "Done", "class": "done", "on": "li" },
        { "name": "Current", "attribute": "aria-current", "value": "step", "on": "li" }
      ]
    },
    {
      "id": "menu",
